<div class="login-form-container">
    <div class="login-form">

        <form action="" >
            <h1>Вход</h1>
            <div class="inputs">
                {{> Input type="text" label="Логин" name="login"}}
                {{> Input type="password" label="Пароль" name="password"}}
            </div>
            <div class="actions">
                {{> Button type="submit" text="Авторизация" className="blue"}}
                <a href="/registration" class="_link">Нет аккаунта?</a>
            </div>
        </form>
    </div>
</div>
