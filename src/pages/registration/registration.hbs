<div class="registration-form-container">
    <div class="registration-form">

        <form action="" >
            <h1>Регистрация</h1>
            <div class="inputs">
                {{> Input type="text" label="Почта" }}
                {{> Input type="text" label="Логин" }}
                {{> Input type="text" label="Имя" }}
                {{> Input type="text" label="Фамилия" }}
                {{> Input type="text" label="Телефон" }}
                {{> Input type="password" label="Пароль" }}
                {{> Input type="password" label="Пароль (еще раз)" }}
